#camera
[submodule "src/sensor_pkg/realsense-ros"]
	path = src/sensor_pkg/realsense-ros
	url = https://github.com/DCUSnSLab/realsense-ros
	branch = flux/4.56.4

#robot
[submodule "src/vehicle/hunter_ros2"]
    path = src/vehicle/hunter_ros2
    url = https://github.com/DCUSnSLab/hunter_ros2.git
    branch = humble-devel
[submodule "src/vehicle/hunter2_description"]
	path = src/vehicle/hunter2_description
	url = https://github.com/DCUSnSLab/hunter2_description.git
	branch = humble-devel
[submodule "src/vehicle/ugv_sdk"]
    path = src/vehicle/ugv_sdk
    url = https://github.com/DCUSnSLab/ugv_sdk.git
    branch = scv-devel

#etc
[submodule "src/capa"]
	path = src/capa
	url = https://github.com/DCUSnSLab/capa
	branch = devel
[submodule "src/flux"]
	path = src/flux
	url = https://github.com/DCUSnSLab/flux
	branch = devel
[submodule "src/tools/orma"]
	path = src/tools/orma
	url = https://github.com/DCUSnSLab/orma
	branch = main
[submodule "src/tools/rosbag2_dataset"]
	path = src/tools/rosbag2_dataset
	url = https://github.com/DCUSnSLab/rosbag2_dataset
	branch = main
[submodule "src/tools/rosbag_recorder"]
	path = src/tools/rosbag_recorder
	url = https://github.com/DCUSnSLab/rosbag_recorder
	branch = main
