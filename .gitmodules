#camera
[submodule "src/sensor_pkg/realsense-ros"]
	path = src/sensor_pkg/realsense-ros
	url = https://github.com/DCUSnSLab/realsense-ros
	branch = flux/4.56.4

#robot
[submodule "src/vehicle/hunter_ros2"]
    path = src/vehicle/hunter_ros2
