	path = src/vehicle/hunter2_description
	url = https://github.com/DCUSnSLab/hunter2_description.git
	branch = humble-devel
[submodule "src/vehicle/ugv_sdk"]
    path = src/vehicle/ugv_sdk
    url = https://github.com/DCUSnSLab/ugv_sdk.git
    branch = scv-devel

