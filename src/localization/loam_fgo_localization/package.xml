<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>loam_fgo_localization</name>
  <version>0.0.1</version>
  <description>Local odometry (IMU + wheel) publishing odom-&gt;base_link (REP-105 local part). Global map-&gt;odom handled elsewhere.</description>
  <maintainer email="min81800@cu.ac.kr">d2-521-30</maintainer>
  <license>MIT</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>libopencv-dev</depend>
  <depend>libpcl-all-dev</depend>
  <depend>lio_sam</depend>
  <depend>eigen</depend>
  <depend>geographiclib</depend>
  <depend>gtsam</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
