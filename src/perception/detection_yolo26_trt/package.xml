<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>detection_yolo26_trt</name>
  <version>0.1.0</version>
  <description>Object detection with an Ultralytics YOLO26 detect model on TensorRT</description>
  <maintainer email="nevlife000720@gmail.com">nevlife</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>flux_wrapper</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>tensorrt_common</depend>
  <depend>vision_msgs</depend>

  <exec_depend>capa_ros</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
